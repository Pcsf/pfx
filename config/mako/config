# pfx notifications.
#
# YOUR FILE — backed up before replacement, never silently overwritten.
# Colours come from the active theme via the include below.

include=~/.config/pfx/current/theme/mako.ini

font=JetBrainsMono Nerd Font 10
width=380
height=140
margin=12
padding=14
border-size=2
border-radius=10
default-timeout=6000
icons=1
max-icon-size=48
anchor=top-right
layer=overlay

[urgency=critical]
default-timeout=0
