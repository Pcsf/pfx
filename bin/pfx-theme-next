#!/bin/bash
#
# pfx:summary=Cycle to the next theme in the list.

set -eo pipefail

mapfile -t themes < <(pfx-theme-list)
((${#themes[@]})) || {
  echo "No themes installed." >&2
  exit 1
}

current=$(pfx-theme-current 2>/dev/null || echo "")

next_index=0
for i in "${!themes[@]}"; do
  if [[ ${themes[i]} == "$current" ]]; then
    next_index=$(((i + 1) % ${#themes[@]}))
    break
  fi
done

exec pfx-theme-set "${themes[$next_index]}"
