#!/bin/bash
#
# pfx:summary=Remove a web app launcher entry and its icon.
#
# Usage:
#   pfx-webapp-remove            # pick from a menu
#   pfx-webapp-remove <name>     # scripted
#
# Removing something that isn't there is not an error — that makes this safe
# to call from scripts and from the menu without existence checks.

set -eo pipefail

APPS_DIR="$HOME/.local/share/applications"
ICON_DIR="$APPS_DIR/icons"

# Only offer entries pfx created; a hand-written .desktop file is the user's.
list_webapps() {
  grep -rl '^Exec=pfx-launch-webapp' "$APPS_DIR" --include='*.desktop' 2>/dev/null |
    xargs -r -n1 basename |
    sed 's/\.desktop$//' |
    sort
}

if (($# == 0)); then
  mapfile -t apps < <(list_webapps)
  ((${#apps[@]})) || {
    echo "No web apps installed."
    exit 0
  }
  name=$(printf '%s\n' "${apps[@]}" | pfx-launch-walker --dmenu -p 'Remove web app…' 2>/dev/null)
  [[ -n $name ]] || exit 0
else
  name="$1"
fi

rm -f "$APPS_DIR/${name}.desktop" "$ICON_DIR/${name}.png"

command -v update-desktop-database >/dev/null 2>&1 &&
  update-desktop-database "$APPS_DIR" 2>/dev/null || true

echo "Removed '$name'."
